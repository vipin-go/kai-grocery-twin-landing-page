          "step": 1,
          "defaultValue": 20,
          "format": "percent",
          "group": "economics"
        },
        {
          "id": "license",
          "label": "Platform licence per month",
          "type": "slider",
          "min": 0,
          "max": 6000,
          "step": 50,
          "defaultValue": 1500,
          "format": "currency",
          "group": "economics"
        },
        {
          "id": "allocation_volume",
          "label": "Share used to absorb more volume",
          "help": "Throughput: extra work the same team can take. Valued as capacity creation, not cash leaving payroll.",
          "type": "slider",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 50,
          "format": "percent",
          "group": "allocation"
        },
        {
          "id": "allocation_billable",
          "label": "Share used for higher-value / billable work",
          "help": "Positive productivity: advisory, selling, or other contribution-margin work.",
          "type": "slider",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 25,
          "format": "percent",
          "group": "allocation"
        },
        {
          "id": "allocation_cost_reduction",
          "label": "Share that is genuine cost reduction",
          "help": "Negative productivity removed as cash: overtime, contractors, or work you would otherwise pay for.",
          "type": "slider",
          "min": 0,
          "max": 100,
          "step": 1,
          "defaultValue": 17,
          "format": "percent",
          "group": "allocation"
        },
        {
          "id": "contribution_rate",
          "label": "Contribution margin / hour of higher-value work",
          "help": "Used only for the billable/advisory share. This is not an hourly salary.",
          "type": "slider",
          "min": 20,
          "max": 400,
          "step": 5,
          "defaultValue": 150,
          "format": "currency",
          "group": "allocation"
        },
        {
          "id": "expected_error_cost",
          "label": "Expected monthly error / rework cost today",
          "type": "slider",
          "min": 0,
          "max": 20000,
          "step": 50,
          "defaultValue": 800,
          "format": "currency",
          "group": "workload"
        },
        {
          "id": "error_reduction_share",
          "label": "Share of that error cost avoided",
          "type": "slider",
          "min": 0,
          "max": 90,
          "step": 5,
          "defaultValue": 35,
          "format": "percent",
          "group": "workload"
        }
      ],
      "metrics": [
        {
          "id": "hours_removed",
          "label": "Repetitive work automated",
          "formula": "locations * hours_per_location_per_week * weeks_per_month * (automation_share / 100)",
          "format": "hours",
          "kind": "card",
          "layer": "operations",
          "productivity": "negative",
          "scalesWithPeriod": true,
          "scalesWithScenario": false,
          "note": "Negative productivity: operating burden removed."
        },
        {
          "id": "hours_returned",
          "label": "Capacity returned to the team",
          "formula": "hours_removed",
          "format": "hours",
          "kind": "card",
          "layer": "operations",
          "productivity": "positive",
          "scalesWithPeriod": true,
          "scalesWithScenario": false,
          "note": "Positive productivity: hours now available for better work."
        },
        {
          "id": "work_units",
          "label": "Locations modeled",
          "formula": "locations",
          "format": "integer",
          "kind": "card",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "unused_share",
          "label": "Unused capacity share",
          "formula": "100 - allocation_volume - allocation_billable - allocation_cost_reduction",
          "format": "percent",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": false,
          "scalesWithScenario": false
        },
        {
          "id": "volume_hours",
          "label": "Hours allocated to more volume",
          "formula": "hours_returned * (allocation_volume / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "billable_hours",
          "label": "Hours allocated to higher-value work",
          "formula": "hours_returned * (allocation_billable / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "cost_hours",
          "label": "Hours that become genuine cost reduction",
          "formula": "hours_returned * (allocation_cost_reduction / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "unused_hours",
          "label": "Hours held as unused capacity",
          "formula": "hours_returned * (unused_share / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "monthly_tokens",
          "label": "Tokens per month",
          "formula": "hours_removed * tokens_per_unit",
          "format": "tokens",
          "kind": "hidden",
          "layer": "economics",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "model_cost",
          "label": "AI model cost (est.)",
          "formula": "(monthly_tokens * (1 - output_share / 100) / 1000000) * input_price + (monthly_tokens * (output_share / 100) / 1000000) * output_price",
          "format": "currency",
          "kind": "breakdown-cost",
          "layer": "economics",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "all_in_cost",
          "label": "All-in AI cost",
          "formula": "model_cost + license",
          "format": "currency",
          "kind": "summary-cost",
          "layer": "economics",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "cost_elimination",
          "label": "Genuine cost eliminated",
          "formula": "cost_hours * capacity_rate",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "cost-elimination",
          "scalesWithPeriod": true,
          "scalesWithScenario": false,
          "note": "Overtime, contractors, or other spend you would actually stop."
        },
        {
          "id": "revenue_productivity",
          "label": "Contribution from higher-value work",
          "formula": "billable_hours * contribution_rate",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "revenue-productivity",
          "scalesWithPeriod": true,
          "scalesWithScenario": true,
          "note": "Valued at contribution margin, not salary."
        },
        {
          "id": "throughput_value",
          "label": "Capacity to take more volume",
          "formula": "volume_hours * capacity_rate",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "throughput",
          "scalesWithPeriod": true,
          "scalesWithScenario": true,
          "note": "Shadow price of extra throughput, not a payroll saving."
        },
        {
          "id": "error_value",
          "label": "Expected error and rework avoided",
          "formula": "expected_error_cost * (error_reduction_share / 100)",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "error-avoidance",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "economic_value",
          "label": "Modeled economic value",
          "formula": "cost_elimination + revenue_productivity + throughput_value + error_value",
          "format": "currency",
          "kind": "summary-benefit",
          "layer": "value",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "net_value",
          "label": "Economic value after AI cost",
          "formula": "economic_value - all_in_cost",
          "format": "currency",
          "kind": "card",
          "layer": "value",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "return_multiple",
          "label": "Economic return on all-in AI cost",
          "formula": "economic_value / all_in_cost",
          "format": "multiplier",
          "kind": "summary-roi",
          "layer": "value",
          "scalesWithPeriod": false,
          "scalesWithScenario": false
        }
      ],
      "projection": {
        "months": 12,
        "costMetricId": "all_in_cost",
        "benefitMetricId": "net_value",
        "yearOneLabel": "Year one economic value after AI cost",
        "costLabel": "AI cost (all-in)",
        "benefitLabel": "Economic value after cost"
      },
