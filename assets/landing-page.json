        },
        {
          "id": "output_price",
          "label": "Model output price / 1M tokens",
          "type": "number",
          "min": 0,
          "max": 80,
          "step": 0.25,
          "defaultValue": 10,
          "format": "currency",
          "group": "economics"
        },
        {
          "id": "output_share",
          "label": "Share of tokens that are output",
          "type": "slider",
          "min": 5,
